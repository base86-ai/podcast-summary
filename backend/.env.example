# Rename to .env and fill in values
PORT=3000
NODE_ENV=production


# OpenAI
OPENAI_API_KEY=sk-...
# Model knobs (cheap-by-default; you can change at runtime via query params too)
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_SUMMARIZE_MODEL=gpt-4o-mini


# Gumroad
GUMROAD_PRODUCT_ID=xxxxxxxxxxxxxxxx
GUMROAD_ACCESS_TOKEN=xxxxxxxxxxxxxxxx # optional (for server-side checks)


# Security / limits
MAX_UPLOAD_MB=60
REQUEST_TIMEOUT_MS=180000 # 3 minutes per request